@article{aroleeFluctuationsLargestEigenvalues2025,
  title = {Fluctuations of the Largest Eigenvalues of Transformed Spiked {{Wigner}} Matrices},
  author = {{Aro Lee} and {Ji Oon Lee}},
  year = {2025},
  abstract = {We consider a spiked random matrix model obtained by applying a function entrywise to a signal-plus-noise symmetric data matrix. We prove that the largest eigenvalue of this model, which we call a transformed spiked Wigner matrix, exhibits Baik-Ben Arous-P{\textbackslash}'ech{\textbackslash}'e (BBP) type phase transition. We show that the law of the fluctuation converges to the Gaussian distribution when the effective signal-to-noise ratio (SNR) is above the critical number, and to the GOE Tracy-Widom distribution when the effective SNR is below the critical number. We provide precise formulas for the limiting distributions and also concentration estimates for the largest eigenvalues, both in the supercritical and the subcritical regimes.},
  annotation = {ARXIV\_ID: 2502.04720\\
S2ID: 557f0e4c8f4818beccaacffadadccea60e2852a7}
}

@misc{colomerQuantumHypothesisTesting2025,
  title = {Quantum {{Hypothesis Testing Lemma}} for {{Deterministic Identification}} over {{Quantum Channels}}},
  author = {Colomer, Pau and Deppe, Christian and Boche, Holger and Winter, Andreas},
  year = {2025},
  month = apr,
  number = {arXiv:2504.20991},
  eprint = {2504.20991},
  primaryclass = {cs},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2504.20991},
  urldate = {2025-05-02},
  abstract = {In our previous work, we presented the Hypothesis Testing Lemma, a key tool that establishes sufficient conditions for the existence of good deterministic identification (DI) codes for memoryless channels with finite output, but arbitrary input alphabets. In this work, we provide a full quantum analogue of this lemma, which shows that the existence of a DI code in the quantum setting follows from a suitable packing in a modified space of output quantum states. Specifically, we demonstrate that such a code can be constructed using product states derived from this packing. This result enables us to tighten the capacity lower bound for DI over quantum channels beyond the simultaneous decoding approach. In particular, we can now express these bounds solely in terms of the Minkowski dimension of a certain state space, giving us new insights to better understand the nature of the protocol, and the separation between simultaneous and non-simultaneous codes. We extend the discussion with a particular channel example for which we can construct an optimum code.},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Information Theory,Mathematics - Information Theory,Quantum Physics},
  file = {C\:\\Users\\heewo\\Zotero\\storage\\TGI85DBZ\\Colomer 등 - 2025 - Quantum Hypothesis Testing Lemma for Deterministic Identification over Quantum Channels.pdf;C\:\\Users\\heewo\\Zotero\\storage\\CM87BCW6\\2504.html}
}

