  title = {Quantum {{Hypothesis Testing Lemma}} for {{Deterministic Identification}} over {{Quantum Channels}}},
  author = {Colomer, Pau and Deppe, Christian and Boche, Holger and Winter, Andreas},
  year = {2025},
